REPO = "avishai0258/steamos-egpu-manager"
REPORT_FILE = os.path.join(HOME, "egpu-manager-report.md")


def report(kind="works"):
    """A shareable hardware report (no serial numbers or user names) plus a prefilled GitHub issue URL."""
    import urllib.parse
    st = status()
    dmi = lambda k: (read(f"/sys/class/dmi/id/{k}", "") or "").strip()
    osr = read("/etc/os-release", "") or ""
    ver = re.search(r'^VERSION_ID="?([^"\n]*)', osr, re.M)
    i = find_igpu()
    gpu, itf = st.get("gpu") or {}, st.get("interface") or {}
    lines = [
        f"- **Handheld:** {dmi('sys_vendor')} {dmi('product_version') or dmi('product_name')} (BIOS {dmi('bios_version')})",
        f"- **SteamOS:** {ver.group(1) if ver else '?'} · kernel {os.uname().release}",
        f"- **Built-in GPU:** {gpu_name(i) if i else '?'}",
        f"- **eGPU:** {gpu.get('name', 'not detected')} ({gpu.get('id', '?')}) · PCIe {gpu.get('link', '?')}",
        f"- **Connection:** {itf.get('label', '?')} · dock chip: {itf.get('device', '?')}",
        f"- **Monitor on eGPU:** {', '.join(m['name'] for m in st.get('monitors') or []) or 'none'}",
        f"- **eGPU Manager:** {VERSION} · auto switch {'on' if st.get('auto_switch') else 'off'} · shader swap {'on' if st.get('shader_swap') else 'off'}",
    ]
    checks = []
    try:
        for c in doctor():
            checks.append(f"- [{c['status']}] {c['label']}" + (f" — {c['detail']}" if c.get("detail") else ""))
    except Exception as e:
        checks.append(f"- doctor failed: {e}")
    log_lines = []
    try:
        r = subprocess.run(["journalctl", "--user", "-b", "--no-pager", "-o", "short", "-g", "egpu-auto"],
                           capture_output=True, text=True, env=SAFE_ENV, timeout=20)
        log_lines = [re.sub(r"^\S+ \S+ \S+ \S+ ", "", l) for l in r.stdout.splitlines()[-40:]]
    except Exception:
        pass
    k = subprocess.run(["journalctl", "-k", "-b", "--no-pager", "-o", "short-monotonic", "-g",
                        "amdgpu 0000:[0-9a-f]+:00.0.*(error|fail|lost)|pciehp|thunderbolt.*(disconnect|error)"],
                       capture_output=True, text=True, env=SAFE_ENV, timeout=20).stdout.splitlines()[-15:]
    k = [re.sub(r"^(\[[^]]+\]) \S+ kernel: ", r"\1 ", l) for l in k]   # drop the host name
    title = ("Works: " if kind == "works" else "Problem: ") + \
        f"{dmi('product_version') or dmi('product_name')} + {gpu.get('name', 'eGPU')} ({itf.get('label', '?')})"
    body = "\n".join(
        (["**It works for me.**"] if kind == "works" else ["**What went wrong:** <!-- describe it here -->"]) +
        ["", "### Hardware"] + lines + ["", "### Setup check"] + checks +
        ["", "<details><summary>Log</summary>", "", "```"] + log_lines + k + ["```", "</details>"])
    with open(REPORT_FILE, "w") as f:
        f.write(f"# {title}\n\n{body}\n")
    short = body if len(body) < 6000 else body[:6000] + "\n```\n(log cut: full report in ~/egpu-manager-report.md)"
    url = f"https://github.com/{REPO}/issues/new?" + urllib.parse.urlencode(
        {"title": title, "body": short, "labels": "hardware-works" if kind == "works" else "bug"})
    return {"ok": True, "title": title, "body": body, "url": url, "file": REPORT_FILE}


def uninstall_decky_plugin():
    import shutil
    dest = os.path.join(HOME, "homebrew", "plugins", "eGPU Manager")
    if os.path.isdir(dest):
        shutil.rmtree(dest)
        subprocess.run(["systemctl", "restart", "plugin_loader.service"], env=SAFE_ENV)
    return 0


# ---------------------------------------------------------------- privileged
def main_priv(args):
    if not IS_ROOT:
        raise CtlError("must run as root")
    if args[:1] == ["_authorize"]:
        authorize_docks()
        return 0
    if args[:1] == ["_setup"] and len(args) == 2:
        # First-time setup in one password prompt: approve the dock, install the Decky plugin.
        authorize_docks()
        return install_decky_plugin(args[1])
    if args[:1] == ["_install-plugin"] and len(args) == 2:
        return install_decky_plugin(args[1])
    if args[:1] == ["_uninstall-plugin"]:
        return uninstall_decky_plugin()
    if args[:1] == ["_rescan"]:
        with open("/sys/bus/pci/rescan", "w") as f:
            f.write("1")
        return 0
    if args[:1] == ["_remove"] and len(args) == 2:
        slot = args[1]
        d = f"{SYS_PCI}/{slot}"
        if not SLOT_RE.match(slot) or not os.path.isdir(d):
            raise CtlError(f"invalid device {slot}")
        if not (read(f"{d}/class", "") or "").startswith("0x03") or read(f"{d}/boot_vga") == "1":
            raise CtlError(f"{slot} is not an external GPU")
        base = slot.rsplit(".", 1)[0]
        funcs = sorted(glob.glob(f"{SYS_PCI}/{base}.*"), reverse=True)  # audio (.1) before GPU (.0)
        for fn in funcs:
            if os.path.exists(f"{fn}/remove"):
                with open(f"{fn}/remove", "w") as f:
                    f.write("1")
        return 0
    raise CtlError("unknown privileged command")


# ---------------------------------------------------------------- CLI
def main(argv):
    cmd = argv[0] if argv else "status"
    as_json = "--json" in argv
    try:
        if cmd.startswith("_"):
            return main_priv(argv)
        if cmd == "status":
            st = status()
            print(json.dumps(st) if as_json else status_text(st))
            return 0
        if cmd == "mode":
            print(want_mode())
            return 0
        if cmd == "session-env":
            session_env()
            return 0
        if cmd == "wait-boot":
            wait_boot()
            return 0
        if cmd == "sync":
            sync(settle="--settle" in argv)
            return 0
        if cmd in ("connect", "disconnect"):
            msg = connect() if cmd == "connect" else disconnect()
        elif cmd == "restart":
            msg = restart_session()
        elif cmd == "switch" and len(argv) > 1 and argv[1] in ("egpu", "igpu"):
            msg = switch(argv[1])
        elif cmd == "set" and len(argv) > 2 and argv[1] in ("USE_EGPU", "AUTO_SWITCH", "SHADER_SWAP") \
                and argv[2] in ("on", "off"):
            msg = set_option(argv[1], argv[2] == "on")
        elif cmd == "shader-swap" and len(argv) > 1:
            t = argv[1]
            prof = profile_for("egpu" if t == "egpu" or (t == "desktop" and find_egpu()) else "igpu") \
                if t in ("egpu", "igpu", "desktop") else t
            if not re.fullmatch(r"(igpu|egpu-[0-9a-f]{4}_[0-9a-f]{4})", prof):
                raise CtlError("invalid profile")
            msg = shader_swap(prof)
        elif cmd == "shader-restore":
            msg = shader_restore()
        elif cmd == "shader-games":
            print(json.dumps(shader_games()))
            return 0
        elif cmd == "shader-delete" and len(argv) > 2:
            msg = shader_delete(argv[1], argv[2])
        elif cmd == "shader-info":
            print(json.dumps(shader_info()) if as_json else json.dumps(shader_info(), indent=1))
            return 0
        elif cmd == "doctor":
            res = doctor()
            if as_json:
                print(json.dumps(res))
            else:
                icon = {"ok": "[ OK ]", "warn": "[WARN]", "fail": "[FAIL]", "info": "[INFO]"}
                for c in res:
                    print(f"{icon[c['status']]} {c['label']}" + (f"\n       {c['detail']}" if c["detail"] else ""))
            return 0
        elif cmd == "authorize":
            priv("_authorize")
            msg = "Dock authorized."
        elif cmd == "backlight" and len(argv) > 1 and argv[1] in ("off", "restore"):
            try:
                msg = backlight(argv[1])
            except OSError as e:
                raise CtlError(f"Can't change the backlight: {e}")
        elif cmd == "report":
            r = report(argv[1] if len(argv) > 1 and argv[1] in ("works", "problem") else "works")
            print(json.dumps(r) if as_json else f"{r['title']}\n\n{r['body']}\n\nSaved to {r['file']}\nShare it: {r['url'][:80]}...")
            return 0
        elif cmd == "desktop-env":
            print(desktop_env())
            return 0
        elif cmd == "auto" and len(argv) > 1 and argv[1] in ("on", "off"):
            msg = set_auto(argv[1] == "on")
        elif cmd in ("version", "--version"):
            print(VERSION)
            return 0
        else:
            print(__doc__)
            return 2
        print(json.dumps({"ok": True, "message": msg}) if as_json else msg)
        return 0
    except CtlError as e:
        if as_json:
            print(json.dumps({"ok": False, "message": str(e)}))
        else:
            print(str(e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
